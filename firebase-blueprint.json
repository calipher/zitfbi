      "title": "UserPrivateProfile",
      "description": "Private Google user account profile isolated per authenticated UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the owner",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google account email",
          "minLength": 5,
          "maxLength": 160
        },
        "displayName": {
          "type": "string",
          "description": "User full name",
          "minLength": 1,
          "maxLength": 120
        },
        "department": {
          "type": "string",
          "description": "ZITF institutional department",
          "minLength": 1,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp"
        }
      },
      "required": ["uid", "email", "displayName", "department", "createdAt", "updatedAt"]
    },
    "AdminRegistryEntry": {
      "title": "AdminRegistryEntry",
