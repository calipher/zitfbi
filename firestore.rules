    // Alert Events (Terminal Lock once Resolved for non-admins)
    match /alertEvents/{eventId} {
      allow get: if isValidId(eventId) && isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isBootstrappedAdminEmail());
      allow create: if isValidId(eventId) &&
