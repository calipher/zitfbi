    // Email Dispatch Logs
    match /emailDispatches/{dispatchId} {
      allow get: if isValidId(dispatchId) && isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isBootstrappedAdminEmail());
      allow create: if isValidId(dispatchId) &&
        isSignedIn() &&
        isValidEmailDispatch(incoming(), dispatchId) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(dispatchId) &&
        isAdmin() &&
        isValidEmailDispatch(incoming(), dispatchId) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isValidId(dispatchId) && isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // Immutable Workspace Audit Logs (Append-Only; updates forbidden, deletes admin-only)
    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isBootstrappedAdminEmail());
      allow create: if isValidId(logId) &&
        isSignedIn() &&
        isValidAuditLog(incoming(), logId) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(logId) && isAdmin();
    }

    // ZITF Personnel RBAC Directory Records (Tiered RBAC update protection)
    match /directoryUsers/{staffId} {
      allow get: if isValidId(staffId) && isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isBootstrappedAdminEmail());
      allow create: if isValidId(staffId) &&
        isSignedIn() &&
        isValidDirectoryUser(incoming(), staffId) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(staffId) &&
        isSignedIn() &&
        isValidDirectoryUser(incoming(), staffId) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'email', 'role', 'department', 'isActive', 'lastLogin', 'updatedAt'
          ])) ||
          (existing().ownerUid == request.auth.uid &&
           incoming().role == existing().role &&
           incoming().isActive == existing().isActive &&
           incoming().diff(existing()).affectedKeys().hasOnly(['name', 'department', 'lastLogin', 'updatedAt']))
        );
      allow delete: if isValidId(staffId) && isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
    }
  }
