        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['lastRunAt', 'nextRunAt', 'lastReportId', 'runCount', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'pillar', 'editionId', 'confidentiality', 'frequency',
            'runTimeUtc', 'dayOfWeekOrMonth', 'recipients', 'includeMiningForecast',
            'isActive', 'nextRunAt', 'updatedAt'
          ])
        );
      allow delete: if isValidId(scheduleId) && isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // Shared Collaboration Briefs (Terminal Lock once Approved for non-admins)
    match /sharedBriefs/{briefId} {
      allow get: if isValidId(briefId) && isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isBootstrappedAdminEmail());
      allow create: if isValidId(briefId) &&
        isSignedIn() &&
        isValidSharedBrief(incoming(), briefId) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(briefId) &&
        isSignedIn() &&
        isValidSharedBrief(incoming(), briefId) &&
        (isAdmin() || (existing().ownerUid == request.auth.uid && existing().workflowStatus != 'Approved')) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
