          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'systemType', 'mode', 'targetModule', 'endpointUrl', 'dataPath',
            'authType', 'authHeaderName', 'autoDeduplicate', 'description', 'status', 'updatedAt'
          ])
        );
      allow delete: if isValidId(connectorId) && isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
