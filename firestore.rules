        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['lastEvaluatedAt', 'lastTriggeredAt', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'metricKey', 'operator', 'threshold', 'severity',
            'editionId', 'notifyRoles', 'recipients', 'isActive', 'updatedAt'
          ])
        );
      allow delete: if isValidId(ruleId) && isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
