    // Connector Sync Logs (Append-only logs)
    match /connectorSyncLogs/{logId} {
      allow get: if isValidId(logId) && isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isBootstrappedAdminEmail());
