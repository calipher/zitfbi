        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'sector', 'marketType', 'summary', 'keyIndicators',
          'estimatedMarketValueUsd', 'growthRateYoY', 'zimbabweMarketContext',
          'sourceAttribution', 'date', 'isDemo', 'updatedAt'
        ]);
      allow delete: if isValidId(insightId) && isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // Reports Registry
    match /biReports/{reportId} {
      allow get: if isValidId(reportId) && isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
