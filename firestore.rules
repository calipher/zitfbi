    // Scheduled Reports
    match /scheduledReports/{scheduleId} {
      allow get: if isValidId(scheduleId) && isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isBootstrappedAdminEmail());
      allow create: if isValidId(scheduleId) &&
