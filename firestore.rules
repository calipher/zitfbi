        ]);
      allow delete: if isValidId(briefId) && isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // Collaboration Annotations
    match /annotations/{commentId} {
      allow get: if isValidId(commentId) && isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isBootstrappedAdminEmail());
