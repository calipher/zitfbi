    }

    // Threshold Alert Rules
    match /thresholdAlertRules/{ruleId} {
      allow get: if isValidId(ruleId) && isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isBootstrappedAdminEmail());
      allow create: if isValidId(ruleId) &&
