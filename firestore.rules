    // External Connectors
    match /externalConnectors/{connectorId} {
      allow get: if isValidId(connectorId) && isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isBootstrappedAdminEmail());
